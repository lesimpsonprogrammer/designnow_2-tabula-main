# Core application
VITE_APP_NAME=Tabula Design Now
VITE_APP_URL=https://www.tabuladesignnow.com
VITE_APP_ENV=production

# Supabase — browser safe
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Code Studio
VITE_ENABLE_JAVASCRIPT=true
VITE_ENABLE_PYTHON=true
VITE_ENABLE_CODE_EXECUTION=true

# Execution safeguards
VITE_EXECUTION_TIMEOUT_MS=5000
VITE_MAX_CODE_SIZE_KB=250
VITE_MAX_CONSOLE_LINES=500

# Python / Pyodide
VITE_PYODIDE_VERSION=0.29.0
VITE_PYTHON_PACKAGES_ENABLED=true

# Product controls
VITE_ENABLE_AUTOSAVE=true
VITE_ENABLE_PREVIEW=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_GITHUB_SYNC=false
VITE_ENABLE_AI=false
